SEARXNG_SECRET=replace-with-a-long-random-secret
WEBSEARCH_API_KEY=replace-with-a-long-random-api-key
CRAWL4AI_API_TOKEN=replace-with-a-long-random-crawl4ai-token
# Optional comma-separated Brave Search API keys for primary discovery.
# Empty = SearXNG-only discovery (today's behavior).
BRAVE_API_KEYS=

# Cross-encoder reranker. Defaults live in docker-compose.yml; override here.
# The cpu-* image tags are amd64 only, so Apple Silicon / arm64 hosts must pin the
# arm64 tag explicitly:
# RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9.4
# RERANKER_MODEL_ID=mixedbread-ai/mxbai-rerank-xsmall-v1
# RERANKER_MODEL_REVISION=b5c6e9da73abc3711f593f705371cdbe9e0fe422
# Reranking knobs read by the api service:
# RERANK_PREFILTER=10   chunks the lexical pass hands to the cross-encoder
# RERANK_MAX_CHARS=512  characters per passage sent to the cross-encoder
# RERANK_BATCH=32       documents per cross-encoder request (<= --max-client-batch-size)
# RERANK_WEIGHT=0.2     weight of the page's discovery rank next to the cross-encoder score
# RERANK_TIMEOUT=4      seconds before falling back to lexical order
# RERANK_COOLDOWN=300   after a cross-encoder failure, skip it this long and rank lexically
#
# These two are the ones that decide whether the cross-encoder finishes inside
# RERANK_TIMEOUT on CPU: cost scales with passages x characters. Raise them with the
# timeout, not on their own, and watch the `rerank_path` field in the search log.

# Chrome version the Crawl4AI image bundles; the crawl user agent must match it, so
# bump this together with the crawl4ai image tag (0.9.4 ships Chrome for Testing
# 153.0.8010.12). A UA that disagrees with the rendering engine is itself a signal.
# CRAWL4AI_CHROMIUM_VERSION=153.0.8010.12
