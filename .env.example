SEARXNG_SECRET=replace-with-a-long-random-secret
WEBSEARCH_API_KEY=replace-with-a-long-random-api-key
CRAWL4AI_API_TOKEN=replace-with-a-long-random-crawl4ai-token
# Optional comma-separated Brave Search API keys for fallback discovery.
# Without Firecrawl or Brave, discovery uses SearXNG only.
BRAVE_API_KEYS=

# Search pipeline knobs (defaults in docker-compose.yml/api/app.py):
# SEARCH_CANDIDATES=10  default discovery candidates per search
# DISCOVERY_TIMEOUT=20  whole-request search-provider budget in seconds
# MAX_RESULTS=5         default results returned per search
# CHUNK_SIZE=1800       characters per ranked chunk
# MAX_PAGE_CHARS=60000  characters kept per crawled page
# CRAWL_CONCURRENCY=3   parallel crawls per search
# Health probe/cache knobs (defaults in api/app.py):
# HEALTH_TIMEOUT=5      seconds per internal service probe
# HEALTH_CACHE_TTL=60   seconds health verdicts are cached; older provider outcomes get a stale: label
# Last-known success remains available until superseded; polling does not renew provider timestamps.

# Cross-encoder reranker. Defaults live in docker-compose.yml; override here.
# The cpu-* image tags are amd64 only, so Apple Silicon / arm64 hosts must pin the
# arm64 tag explicitly:
# RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9.4
# RERANKER_MODEL_ID=mixedbread-ai/mxbai-rerank-xsmall-v1
# RERANKER_MODEL_REVISION=b5c6e9da73abc3711f593f705371cdbe9e0fe422
# Reranking knobs read by the api service:
# RERANK_PREFILTER=10   chunks the lexical pass hands to the cross-encoder
# RERANK_MAX_CHARS=512  characters per passage sent to the cross-encoder
# RERANK_BATCH=32       documents per cross-encoder request (<= --max-client-batch-size)
# RERANK_WEIGHT=0.2     weight of the page's discovery rank next to the cross-encoder score
# RERANK_TIMEOUT=4      seconds before falling back to lexical order
# RERANK_COOLDOWN=300   after a cross-encoder failure, skip it this long and rank lexically
#
# These two are the ones that decide whether the cross-encoder finishes inside
# RERANK_TIMEOUT on CPU: cost scales with passages x characters. Raise them with the
# timeout, not on their own, and watch the `rerank_path` field in the search log.

# Chrome version the Crawl4AI image bundles; the crawl user agent must match it, so
# bump this together with the crawl4ai image pin (0.9.5 ships Chrome for Testing
# 156.0.8078.4). A UA that disagrees with the rendering engine is itself a signal.
# CRAWL4AI_CHROMIUM_VERSION=156.0.8078.4

# Optional ordered Firecrawl keys, each with a required unique human-readable label.
# Labels are trimmed and must be nonempty, printable and free of credentials.
# Duplicate labels/keys and unlabeled keys are rejected. Keep actual keys in private .env.
# Empty or [] disables Firecrawl even if legacy FIRECRAWL_BUDGETS_JSON is set.
# Legacy input is used only when FIRECRAWL_KEYS_JSON is absent; each entry needs one key.
# Same-team keys share credits; failover adds no funds and never bypasses caps/rate/policy.
# FIRECRAWL_KEYS_JSON='[{"label":"primary@example.test","key":"fc-REPLACE-ONE"},{"label":"secondary@example.test","key":"fc-REPLACE-TWO"}]'
FIRECRAWL_KEYS_JSON=
# Append-only JSONL usage ledger. The API container mounts ./data/api at /data;
# create that host directory writable by the container's `app` user.
FIRECRAWL_USAGE_LOG=/data/firecrawl-usage.jsonl
# Inline search extras caps (UTF-8 bytes). Oversized rawBase64 is omitted.
SEARCH_MAX_EXTRAS_BYTES=200000
SEARCH_MAX_TOTAL_EXTRAS_BYTES=1000000
SEARCH_MAX_METADATA_BYTES=20000
# text (default) or json. JSON lines carry ts, level, logger, request_id, message.
LOG_FORMAT=text
# Firecrawl inline scrape safety gates. Leave false unless callers are trusted:
# actions can run browser automation/JS, headers can carry cookies, profiles persist state.
ALLOW_FIRECRAWL_ACTIONS=false
ALLOW_FIRECRAWL_HEADERS=false
ALLOW_FIRECRAWL_PROFILE=false
# Log raw search queries at DEBUG (default false; INFO logs a query hash only).
LOG_QUERIES=false
